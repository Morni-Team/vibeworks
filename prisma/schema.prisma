// ─────────────────────────────────────────────────────────────
//  VibeWorks – Datenmodell (PostgreSQL)
// ─────────────────────────────────────────────────────────────

// Prisma 7: der Client wird nach src/generated/prisma erzeugt (nicht
// eingecheckt) und spricht über @prisma/adapter-pg mit Postgres – ohne
// eigene Query-Engine. Die Verbindung steht in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

/// SINGLE: genau ein Konto. MULTI: beliebig viele, strikt getrennte Konten.
enum InstanceMode {
  SINGLE
  MULTI
}

enum ProjectStatus {
  IDEA
  PLANNING
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum Recurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ActivityKind {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  TASK_ADDED
  TASK_MOVED
  TASK_DELETED
}

/// Art einer Seite in den Mini-Docs
enum DocKind {
  PAGE
  WEB
  HTML
}

/// Wer eine Seite sehen darf
enum DocShare {
  PRIVATE
  ACCOUNTS
  PUBLIC
}

// ── Instanz ─────────────────────────────────────────────────

/// Genau eine Zeile (id = "instance").
model Settings {
  id                        String       @id @default("instance")
  mode                      InstanceMode @default(SINGLE)
  allowRegistration         Boolean      @default(false)
  /// „Passwort vergessen“ per E-Mail erlauben (braucht SMTP) – aus, bis ein Admin es einschaltet
  allowPasswordReset        Boolean      @default(false)
  /// Höchstzahl Karten je Spalte im Aufgabenbrett (0 = unbegrenzt).
  taskColumnLimit           Int          @default(15)
  /// Wünsche ans Team (an die KI) je Mitglied in 24 Stunden – vom Admin einstellbar (#48)
  wishLimit                 Int          @default(3)
  setupDoneAt               DateTime?
  /// SMTP für Benachrichtigungen per E-Mail (Passwort AES-256-GCM)
  smtpHost                  String?
  smtpPort                  Int?
  smtpSecure                Boolean      @default(false)
  smtpUser                  String?
  smtpPassCipher            String?
  smtpFrom                  String?
  /// Zuletzt gestartete Version – für die Meldung „VibeWorks aktualisiert“
  lastVersion               String?
  /// Discord-Anwendung der Instanz (#105) – Bot-Token und Client-Secret AES-256-GCM
  discordAppId              String?
  discordPublicKey          String?
  discordBotTokenCipher     String?
  discordClientSecretCipher String?
  discordCommandsAt         DateTime?
  updatedAt                 DateTime     @updatedAt
}

// ── Konten und Anmeldung ────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Immer kleingeschrieben.
  username     String   @unique
  displayName  String?
  email        String?  @unique
  /// scrypt$N$r$p$salt$hash – null bei reinen Passkey-Konten.
  passwordHash String?
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  /// Passwort zuletzt gesetzt – für die Erinnerung zum Wechseln
  passwordChangedAt    DateTime?
  /// Nach wie vielen Tagen an einen Wechsel erinnern (0 = nie)
  passwordReminderDays Int       @default(180)
  passwordRemindedAt   DateTime?
  /// Bittet darum, dass ein Admin ein neues Passwort vergibt (#43)
  resetRequestedAt     DateTime?

  /// E-Mail als Notfallweg beim zweiten Faktor (#109) – aus, bis man es einschaltet
  mfaEmail Boolean @default(false)

  /// TOTP-Schlüssel (verschlüsselt). Scharf erst mit totpEnabledAt.
  totpSecret    String?
  totpEnabledAt DateTime?
  totpLastStep  Int?

  /// Persönliches Design (Hintergrund, Farben, Modus, Glas) – siehe src/lib/theme.
  theme Json?

  /// Sprache der Oberfläche ("de" | "en") – null heißt: Browsersprache
  locale String?

  /// Ausgeblendete Bereiche (#109): { hidden: [...] } – siehe src/lib/uiPrefsLogic.ts
  ui Json?

  /// Erste Schritte (#100): { hideDone, dismissed }
  onboarding Json?

  /// Ideen-Eingang: geheimer Teil der Einwurf-Adresse /api/inbox/in/<token>
  inboxToken     String? @unique
  /// ntfy-Thema, das VibeWorks nach neuen Ideen abfragt, und die letzte gelesene Nachricht
  inboxNtfyUrl   String?
  inboxNtfySince String?

  /// Öffentliches Portfolio unter /u/<username> – aus, bis man es einschaltet
  portfolioPublic Boolean @default(false)
  portfolioBio    String?

  /// Community: von einem Admin gesperrt – lesen geht, schreiben nicht
  communityBannedAt  DateTime?
  communityBanReason String?
  communityPosts     CommunityPost[]
  communityReplies   CommunityReply[]
  communityMessages  CommunityMessage[]
  teamMemberships    TeamMember[]
  teamInvites        TeamInvite[]
  teamMessages       TeamMessage[]
  teamWishes         TeamWish[]
  roles              Role[]

  sessions             Session[]
  passkeys             Passkey[]
  recoveryCodes        RecoveryCode[]
  passwordResets       PasswordReset[]
  mfaPending           MfaPending[]
  loginChecks          LoginCheck[]
  projects             Project[]
  activities           Activity[]
  uploads              Upload[]
  docs                 Doc[]
  memberships          ProjectMember[]
  accessRequests       AccessRequest[]
  gitCredentials       GitCredential[]
  apiTokens            ApiToken[]
  notifications        Notification[]
  createdTasks         Task[]                @relation("TaskCreator")
  taskFocus            TaskFocus[]
  prompts              Prompt[]
  timeEntries          TimeEntry[]
  inboxItems           InboxItem[]
  templates            ProjectTemplate[]
  suggestions          Suggestion[]
  notificationSettings NotificationSettings?
  discordLinks         DiscordLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Serverseitige Sitzung; gespeichert wird nur der SHA-256 des Cookie-Tokens.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Passwort war richtig, der zweite Faktor steht noch aus.
model MfaPending {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  attempts      Int       @default(0)
  /// Notfall-Code per E-Mail (#109): SHA-256 und wann er verschickt wurde
  emailCodeHash String?
  emailCodeAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Nachfrage nach einer Anmeldung über einen Notfallweg (#109): „Warst du das?“
model LoginCheck {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// recovery · email
  method     String
  ip         String?
  userAgent  String?
  /// ok · revoked
  answer     String?
  answeredAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url-Credential-ID
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Einladung zur Registrierung: einmal nutzbar, läuft ab. Gespeichert wird nur der SHA-256 des Codes.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  /// Letzte Zeichen des Codes für die Liste, z. B. "…9f3a"
  hint        String
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?

  @@index([expiresAt])
}

/// Rücksetz-Link für „Passwort vergessen“: gespeichert wird nur der SHA-256, eine Stunde gültig, einmal nutzbar.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Einmal verwendbare WebAuthn-Challenge.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Projekte ────────────────────────────────────────────────

model Project {
  /// Dateifilter: Müll- und Schutz-Muster, erlaubte Pull Requests (src/lib/git/fileFilterLogic.ts, #92)
  fileFilter          Json?
  /// Neue Issues aus dem Git-System übernehmen: off | trusted | all (#69)
  issueImport         String         @default("trusted")
  /// GitHub-Konten mit Rolle im Projekt: [{ login, role: worker | bughunter }] (#69)
  gitPeople           Json?
  /// Projektaufbau: { overview, rows: [{ area, path, purpose, how }], updatedAt, updatedBy } (#101)
  structure           Json?
  /// Kalendertag der letzten Prüfung durch den Aufbau-Wächter (#82)
  structureCheckedOn  String?
  /// CI-Designer (#107): Blöcke und Auslöser, zuletzt ins Repository geschrieben
  ciPipeline          Json?
  ciPublishedAt       DateTime?
  ciPublishedBy       String?
  /// SHA-256 der zuletzt geschriebenen Datei – weicht die gespeicherte Pipeline ab, ist sie noch nicht im Repository
  ciPublishedHash     String?
  /// Bis hierhin wurden Issue-Kommentare auf Bot-Befehle geprüft (#79)
  issueCommentsAt     DateTime?
  id                  String         @id @default(cuid())
  ownerId             String
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  summary             String?
  description         String?
  status              ProjectStatus  @default(IDEA)
  /// 1 niedrig · 2 normal · 3 hoch · 4 kritisch
  priority            Int            @default(2)
  progress            Int            @default(0)
  /// Name eines Akzentverlaufs (siehe src/lib/accents.ts)
  accent              String         @default("violet")
  tags                String[]       @default([])
  favorite            Boolean        @default(false)
  /// Rang innerhalb der Kanban-Spalte
  position            Int            @default(0)
  progressFromTasks   Boolean        @default(false)
  /// Aufgabenbrett: Spaltennamen, Reihenfolge, ausgeblendete Spalten, Einklappen (src/lib/boardConfig.ts)
  boardConfig         Json?
  repoUrl             String?
  /// Zugangstoken für private Repositories, AES-256-GCM-verschlüsselt
  repoTokenCipher     String?
  /// Gekürzte Anzeige des Tokens, z. B. "ghp_…9f3a"
  repoTokenHint       String?
  /// Aufgaben automatisch als Issues im Repository spiegeln (braucht ein Token)
  issueSync           Boolean        @default(true)
  /// Issues im Repository abgeschaltet (HTTP 410) – bis einen Tag danach nicht erneut versuchen (#66)
  issuesOffAt         DateTime?
  /// Repo-Check (GitHub-Workflow) automatisch einrichten und auswerten – aus = Datei wird entfernt
  repoCheck           Boolean        @default(true)
  /// Zweig für den Repo-Check – null heißt Standardzweig
  checkBranch         String?
  /// Aufgaben aus dem Repo-Check: off · urgent (Geheimnisse, Lücken) · all (dazu Semgrep-Befunde)
  checkTasks          String         @default("off")
  /// Lighthouse-Check der Live-Seite (#82, GitHub-Workflow) – aus, bis der Besitzer ihn einschaltet
  lighthouse          Boolean        @default(false)
  /// Geheimer Teil des öffentlichen Links /s/<token> – null heißt „nicht geteilt“
  shareToken          String?        @unique
  /// Geheimnis für eingehende Webhooks (AES-256-GCM) – null heißt „kein Webhook“
  webhookSecretCipher String?
  /// Zuletzt ein gültiger Webhook angekommen
  webhookAt           DateTime?
  /// Fehler-Eingang: geheimer Teil der Adresse /api/errors/in/<key> – null heißt „aus“
  errorKey            String?        @unique
  /// Fehler-Agent (#39): off · notfix – neue Fehler automatisch als Notfix-Aufgabe für Claude
  errorAutoTask       String         @default("off")
  /// Live-Überwachung: die fertige Seite, alle 5 Minuten geprüft
  liveUrl             String?
  /// "up" | "down" – null, solange noch nicht geprüft
  liveState           String?
  /// Fehlschläge in Folge – offline gilt eine Seite erst ab zwei
  liveFails           Int            @default(0)
  liveMs              Int?
  liveError           String?
  /// Seit wann der aktuelle Zustand gilt
  liveSince           DateTime?
  liveCheckedAt       DateTime?
  sslExpiresAt        DateTime?
  sslCheckedAt        DateTime?
  /// Schon gemeldete Warnstufe ("14" | "3") – nach Verlängerung wieder null
  sslNotified         String?
  /// Vorschaubild der Seite (og:image, sonst Icon) als Upload
  coverUploadId       String?
  coverCheckedAt      DateTime?
  /// Projekt-Friedhof: begraben (Status dann ARCHIVED), Ursache, letzte Worte
  buriedAt            DateTime?
  epitaph             String?
  causeOfDeath        String?
  statusBeforeBurial  ProjectStatus?
  /// Im öffentlichen Portfolio des Besitzers zeigen
  inPortfolio         Boolean        @default(false)
  /// In der Community der Instanz vorstellen (nur für angemeldete Konten sichtbar)
  inCommunity         Boolean        @default(false)
  /// Von einem Admin als offizielles Projekt markiert – steht oben in der Community (#59)
  communityOfficial   Boolean        @default(false)
  /// „Später fragen“ – bis dahin kein Hinweis auf dem Dashboard
  nudgeSnoozedUntil   DateTime?

  notes             Note[]
  tasks             Task[]
  activities        Activity[]
  repoCache         RepoCache?
  members           ProjectMember[]
  accessRequests    AccessRequest[]
  uptimeChecks      UptimeCheck[]
  prompts           Prompt[]
  costs             ProjectCost[]
  timeEntries       TimeEntry[]
  suggestions       Suggestion[]
  appErrors         AppError[]
  codeMemos         CodeMemo[]
  aiWorkflows       AiWorkflow[]
  workflowRuns      WorkflowRun[]
  communityPosts    CommunityPost[]
  communityBans     CommunityBan[]
  communityMessages CommunityMessage[]
  teams             ProjectTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, status, position])
  @@index([ownerId, updatedAt])
}

// ── Rollen ──────────────────────────────────────────────────

/// Rolle: benannte Sammlung von Rechten für Projekte oder Teams (src/lib/rolesLogic.ts)
model Role {
  id          String          @id @default(cuid())
  /// project | team
  scope       String
  name        String
  description String?
  permissions String[]        @default([])
  /// Standardrolle (z. B. "project.editor") – bearbeitbar, nicht löschbar
  key         String?         @unique
  /// null = Vorlage der Instanz (pflegen Admins), sonst eigene Rolle dieses Kontos
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  teamShares  ProjectTeam[]
  teamMembers TeamMember[]
  /// Team-Rolle, die einem Team gehört (ownerId dann leer) – pflegen Mitglieder mit „Rollen vergeben“
  teamId      String?
  team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([scope, ownerId])
  @@index([teamId])
}

// ── Teams ───────────────────────────────────────────────────

/// Team: Konten, mit denen man Projekte gemeinsam teilt – Beitritt nur per Einladung
model Team {
  id          String        @id @default(cuid())
  name        String
  createdById String?
  createdAt   DateTime      @default(now())
  members     TeamMember[]
  invites     TeamInvite[]
  projects    ProjectTeam[]
  roles       Role[]
  messages    TeamMessage[]
  wishes      TeamWish[]
  workflows   AiWorkflow[]
}

/// Team-Chat (#38) – nur für Mitglieder
model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

/// Wunsch ans Team (#38): höchstens 3 am Tag je Mitglied; Verwalter nehmen an (→ Aufgabe) oder lehnen ab
model TeamWish {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  /// open | accepted | declined
  status      String    @default("open")
  decidedById String?
  decidedAt   DateTime?
  reason      String?
  projectId   String?
  taskId      String?
  createdAt   DateTime  @default(now())

  @@index([teamId, createdAt])
  @@index([authorId, createdAt])
}

model TeamMember {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Alte Stufe (ADMIN/MEMBER) – nur noch Rückfall, wenn die Rolle gelöscht wurde (neue Vergaben: MEMBER)
  role      String   @default("MEMBER")
  roleId    String?
  roleRef   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

/// Offene Einladung in ein Team – wirkt erst, wenn das Konto annimmt
model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedById String?
  createdAt   DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

/// Freigabe eines Projekts an ein Team: alle Mitglieder bekommen diese Rolle
model ProjectTeam {
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Alte Stufe – nur noch Rückfall, wenn die Rolle gelöscht wurde
  role      ProjectRole @default(VIEWER)
  roleId    String?
  roleRef   Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@id([projectId, teamId])
  @@index([teamId])
}

// ── Community ───────────────────────────────────────────────

/// Beitrag zu einem vorgestellten Projekt: Frage, Idee oder Fehlerbericht
model CommunityPost {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// question | idea | bug
  kind           String           @default("question")
  title          String
  body           String
  /// open | answered | closed
  status         String           @default("open")
  /// Von der Moderation ausgeblendet – sehen nur Autor, Projektbesitzer und Admins
  hidden         Boolean          @default(false)
  replyCount     Int              @default(0)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  replies        CommunityReply[]

  @@index([projectId, lastActivityAt])
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
}

/// Chat-Nachricht: im Chat eines Projekts oder in der Lobby (projectId null)
model CommunityMessage {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Meldung eines Beitrags, einer Antwort oder einer Chat-Nachricht an die Moderation
model CommunityReport {
  id          String    @id @default(cuid())
  /// post | reply
  targetType  String
  targetId    String
  projectId   String
  reporterId  String
  reason      String
  /// open | done
  status      String    @default("open")
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([status, createdAt])
  @@index([projectId, status])
}

/// Sperre für die Community eines Projekts (vom Projektbesitzer oder einem Admin)
model CommunityBan {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([projectId, userId])
}

/// Eigener KI-Workflow eines Projekts (#101) – mitgelieferte stehen in src/lib/aiWorkflowLogic.ts
model AiWorkflow {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Team-Workflow (#82): gilt in allen Projekten, die an das Team freigegeben sind – dann ohne projectId
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String   @default("")
  /// [{ title, check }]
  steps       Json
  authorName  String?
  /// web · mcp
  via         String   @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, key])
  @@unique([teamId, key])
}

/// Discord-Server, in den ein Konto den VibeWorks-Bot eingeladen hat (#105)
model DiscordLink {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId       String
  guildName     String?
  /// Discord-Konto, das eingeladen hat – nur ihm antwortet der Bot mit Daten
  discordUserId String
  discordName   String?
  channelId     String?
  channelName   String?
  /// Benachrichtigungen in den Kanal weiterleiten
  forward       Boolean  @default(true)
  /// off · daily · weekly
  report        String   @default("daily")
  reportSentOn  String?
  lastError     String?
  createdAt     DateTime @default(now())

  @@unique([userId, guildId])
  @@index([discordUserId])
}

/// Geräte-Anmeldung eines KI-Programms (#104) – kurzlebig, der Schlüssel liegt nur bis zur Abholung verschlüsselt hier
model DeviceAuth {
  id             String    @id @default(cuid())
  /// SHA-256 des Geräte-Codes, den nur das Programm kennt
  deviceCodeHash String    @unique
  /// Code zum Eintippen, z. B. BCDF-GHJK
  userCode       String    @unique
  clientName     String
  /// read · tasks · all – gewünscht vom Programm, bei der Freigabe änderbar
  scope          String    @default("tasks")
  ip             String?
  /// pending · approved · denied · claimed
  status         String    @default("pending")
  userId         String?
  tokenId        String?
  tokenCipher    String?
  lastPollAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// Ein Durchlauf eines KI-Workflows (#101) – Schritte als Kopie, damit spätere Änderungen ihn nicht verbiegen
model WorkflowRun {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  /// API-Schlüssel, mit dem die KI gestartet hat – für die Hinweise
  tokenId     String?
  taskId      String?
  workflowKey String
  title       String
  /// [{ title, check }]
  steps       Json
  /// [{ step, status: done | skipped, note, at }]
  results     Json      @default("[]")
  /// running · done · cancelled
  status      String    @default("running")
  summary     String?
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([tokenId, status])
  @@index([projectId, startedAt])
}

/// Memo-Netz (#60): Notiz an einer Datei des Repositories – im Code-Netz sichtbar, auch über MCP
model CodeMemo {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Pfad im Repository (oder pkg:<name>)
  file       String
  text       String
  authorId   String?
  authorName String?
  /// web · mcp
  via        String   @default("web")
  createdAt  DateTime @default(now())

  @@index([projectId, file])
}

/// Fehler-Eingang: gleichartige Fehler einer App, per Fingerabdruck zusammengefasst
model AppError {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SHA-256 aus Art, vereinheitlichter Nachricht und oberster Stack-Zeile (src/lib/bugsLogic.ts)
  fingerprint String
  type        String?
  message     String
  stack       String?
  url         String?
  release     String?
  environment String?
  userAgent   String?
  count       Int       @default(1)
  /// open | resolved | ignored – ein erledigter Fehler, der wiederkommt, ist wieder offen
  status      String    @default("open")
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolvedAt  DateTime?
  /// Daraus angelegte Aufgabe (bewusst ohne Fremdschlüssel)
  taskId      String?

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus  @default(TODO)
  position        Int         @default(0)
  dueDate         DateTime?
  labels          String[]    @default([])
  doneAt          DateTime?
  /// Letzter Statuswechsel – Erledigtes und Blockiertes blendet das Board nach 2 Tagen aus
  statusChangedAt DateTime    @default(now())
  recurrence      Recurrence?
  /// Vorgängerin bei wiederkehrenden Aufgaben (bewusst ohne Fremdschlüssel)
  recurredFrom    String?
  /// Gespiegeltes Issue im verknüpften Repository
  issueNumber     Int?
  issueUrl        String?
  /// Letzter Fehler beim Spiegeln – wird beim nächsten Erfolg geleert
  issueError      String?
  /// Von VibeWorks selbst gepflegte Aufgabe (z. B. "deps:vuln") – je Projekt höchstens eine je Schlüssel
  autoKey         String?
  /// Wer daran arbeitet – frei eingetragen (z. B. „anna“ oder „Claude“), steht auch im Issue
  assignee        String?
  /// Hinweis an die KI (eigener Prompt, Arbeitsweise) – privat, nie im Issue
  aiNote          String?
  /// Für KI gesperrt: über MCP unsichtbar, Issue ohne Inhalt (#76)
  aiLocked        Boolean     @default(false)
  /// Zusatz-Spalte des Bretts (x1 …), sonst null – der Status bleibt der der Grundspalte (#76)
  column          String?
  /// Priorität wie bei Projekten: 1 niedrig · 2 normal · 3 hoch · 4 dringend
  priority        Int         @default(2)
  /// Bearbeiter laut Issue: Zuweisungen (@login) und Labels wie „🤖 Claude“
  issueAssignees  String[]    @default([])
  /// Wer die Aufgabe in VibeWorks angelegt hat – Name als Schnappschuss, steht auch im Issue
  createdById     String?
  createdBy       User?       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName   String?
  /// Weg: web · mcp (per KI) · auto (von VibeWorks selbst)
  createdVia      String?
  focus           TaskFocus[]
  timeEntries     TimeEntry[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([projectId, autoKey])
  @@index([projectId, status, position])
  @@index([dueDate])
}

model Activity {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      ActivityKind
  summary   String
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt, id])
}

/// Zwischengespeicherter Stand des verknüpften Repositories (Commits).
/// Ein fehlgeschlagener Abgleich setzt nur `error` – die zuletzt geholten
/// Commits bleiben stehen.
model RepoCache {
  projectId        String    @id
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// github | gitlab | gitea
  provider         String
  fullName         String
  webUrl           String
  defaultBranch    String?
  description      String?
  stars            Int?
  /// [{ sha, title, body, author, date, url }], neueste zuerst
  commits          Json      @default("[]")
  /// CI des Hauptzweigs: { state, runs: [{ name, state, url, updatedAt }], sha, checkedAt } – null ohne CI
  ci               Json?
  /// Abhängigkeiten aus package.json: { manifest, packages, counts, error, checkedAt } – einmal am Tag
  deps             Json?
  depsCheckedAt    DateTime?
  fetchedAt        DateTime  @default(now())
  error            String?
  /// Fehlschläge in Folge, seit wann, und ob das schon gemeldet wurde
  failCount        Int       @default(0)
  errorSince       DateTime?
  errorNotified    Boolean   @default(false)
  /// Repo-Check (GitHub-Workflow): null = nicht eingerichtet · waiting · running · done · failed
  checkStatus      String?
  /// Bericht aus dem Artefakt (siehe src/lib/git/repoCheckLogic.ts)
  checkReport      Json?
  checkRunUrl      String?
  checkRunAt       DateTime?
  checkFetchedAt   DateTime?
  checkError       String?
  /// Zuletzt geprüft, ob die Workflow-Datei im Repository aktuell ist (einmal am Tag)
  checkInstalledAt DateTime?
  /// Lighthouse-Check (#82): Zustände wie beim Repo-Check, Bericht siehe src/lib/git/lighthouseLogic.ts
  lhStatus         String?
  lhReport         Json?
  /// Bester bisheriger Wert je Bereich – Maßstab für „deutlich schlechter“
  lhBaseline       Json?
  lhRunUrl         String?
  lhRunAt          DateTime?
  lhFetchedAt      DateTime?
  lhError          String?
  lhInstalledAt    DateTime?
  /// Lighthouse-Zeitplan: "daily" | "weekly" (null = wöchentlich wie bisher)
  lhSchedule       String?
  /// Stundenversatz in UTC (0–23), damit nicht alle Projekte gleichzeitig prüfen
  lhHour           Int?
}

/// Git-Verbindung eines Kontos (GitHub, GitLab, Gitea/Forgejo, auch selbst
/// gehostet). Gilt für alle eigenen Projekte auf diesem Server, sofern ein
/// Projekt kein eigenes Token hat. Je Konto und Server höchstens eine.
model GitCredential {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// github | gitlab | gitea
  provider        String
  /// host[:port], kleingeschrieben – Abgleich mit der Repository-Adresse
  host            String
  /// https://host[:port] – Basis für API-Aufrufe
  baseUrl         String
  /// Token, AES-256-GCM-verschlüsselt
  cipher          String
  /// Gekürzte Anzeige, z. B. "ghp_…9f3a"
  hint            String
  /// Anmeldename beim Anbieter, beim Speichern ermittelt
  login           String?
  /// Bot-Konto nur für Issues – damit VibeWorks sie nicht unter dem eigenen Profil anlegt (verschlüsselt)
  botCipher       String?
  botHint         String?
  botLogin        String?
  /// Bot als GitHub App (per Klick erstellt): App-ID, Kurzname und privater Schlüssel (verschlüsselt)
  botAppId        String?
  botAppSlug      String?
  botAppKeyCipher String?
  /// Automatischer Import: jedes eigene Repository wird zum Projekt (ohne Forks und archivierte)
  autoImport      Boolean   @default(true)
  importedAt      DateTime?
  /// Letzter Import-Fehler (Übersetzungsschlüssel) und Fehlschläge in Folge
  importError     String?
  importFails     Int       @default(0)
  /// Zuletzt gefundene Repositories (ohne Forks und archivierte)
  importCount     Int       @default(0)
  /// Rechte-Prüfung (#98): Scopes laut Anbieter, Art des Tokens, letzte Prüfung, Fehler, zuletzt gemeldetes Problem
  scopes          String[]  @default([])
  scopeKind       String?
  checkedAt       DateTime?
  checkError      String?
  checkNotified   String?
  /// host/pfad gelöschter oder umgehängter Projekte – werden nicht erneut importiert
  skipRepos       String[]  @default([])
  createdAt       DateTime  @default(now())

  @@unique([userId, host])
}

/// Eigene Projektvorlage: Momentaufnahme von Angaben, Aufgaben und Notizen.
/// Die eingebauten Vorlagen stehen im Code (src/lib/templateData.ts).
model ProjectTemplate {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// { summary, description, accent, tags, priority, progressFromTasks, tasks: [...], notes: [...] }
  data        Json
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

/// OAuth-Anmeldung für KI-Programme (ChatGPT & Co., #141): Autorisierungs-Codes
/// mit PKCE – der Mensch gibt auf /verbinden frei wie bei der Geräte-Anmeldung.
model OAuthFlow {
  id             String    @id @default(cuid())
  /// Client-Kennung aus der dynamischen Registrierung, z. B. "app_abc123"
  clientId       String
  clientName     String
  /// SHA-256 des Autorisierungs-Codes – der Code selbst liegt nur beim Programm
  codeHash       String    @unique
  /// SHA-256 des PKCE-Verifiers, geprüft wird beim Token-Abruf
  codeChallenge  String
  scope          String    @default("tasks")
  /// pending · approved · denied · claimed
  status         String    @default("pending")
  userId         String?
  tokenId        String?
  tokenCipher    String?
  redirectUri    String
  /// state des Programms – wandert auf der Rückkehr unverändert mit
  state          String?
  ip             String?
  lastPollAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

/// Dynamisch registriertes KI-Programm (#141, RFC 7591). Kurzlebig und ohne
/// Konto: gemerkt wird nur, wer sich gemeldet hat und wohin zurückgekehrt
/// werden darf – die Autorisierung prüft beides.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String
  /// Erlaubte Rückkehr-Adressen – exakt so, wie sie bei der Registrierung kamen
  redirectUris String[] @default([])
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// API-Schlüssel für Claude Code und andere MCP-Clients – gespeichert wird nur der SHA-256.
model ApiToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  tokenHash         String    @unique
  /// Gekürzte Anzeige, z. B. "vw_AbCd…9f3a"
  hint              String
  lastUsedAt        DateTime?
  /// Prüfspur: von wo und womit zuletzt benutzt
  lastUsedIp        String?
  lastUsedUserAgent String?
  /// Die KI hat die Agent-Regeln gespeichert und bestätigt (confirm_agent_rules)
  rulesAckAt        DateTime?
  /// Eigene Erinnerung an die KI gilt nur bis hier (#100) – null: unbegrenzt
  reminderUntil     DateTime?
  /// Fingerabdruck der bestätigten Regeln – weicht er ab, erinnert VibeWorks erneut (#79)
  rulesVersion      String?
  /// Zuletzt gemeldeter Client (initialize): Name, Version, verlangte Protokollversion
  clientName        String?
  clientVersion     String?
  clientProtocol    String?
  /// Werkzeug-Umfang: read · tasks · all
  scope             String    @default("all")
  /// Erinnerungen an die KI: default · custom · off, Text und „jeder n-te Aufruf“
  reminderMode      String    @default("default")
  reminderText      String?
  reminderEvery     Int       @default(10)
  /// Projekt-Schlüssel (#106): nur diese Projekte – bei projectScoped und leerer Liste: gar nichts mehr
  projectScoped     Boolean   @default(false)
  projectIds        String[]  @default([])
  /// Läuft ab (null: nie) bzw. ist pausiert
  expiresAt         DateTime?
  disabledAt        DateTime?
  calls             McpCall[]
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([projectIds], type: Gin)
}

/// MCP-Aufrufe fürs Protokoll im Konto – nur Werkzeug, Ergebnis, Dauer, keine Eingaben. Nach 30 Tagen weg.
model McpCall {
  id          String   @id @default(cuid())
  tokenId     String
  token       ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  userId      String
  tool        String
  ok          Boolean
  error       String?
  ms          Int
  /// Aufgabe, um die es ging (aus den Argumenten oder dem Ergebnis) – fürs Info-Fenster
  taskId      String?
  /// Aufgaben, die die KI mit diesem Aufruf gesehen hat (z. B. list_tasks) – #76
  seenTaskIds String[] @default([])
  createdAt   DateTime @default(now())

  @@index([seenTaskIds], type: Gin)
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([taskId, createdAt])
  @@index([tokenId, createdAt])
}

/// Ideen-Eingang: schnell Eingeworfenes, später zu Projekt oder Aufgabe gemacht (dann gelöscht).
model InboxItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  url       String?
  /// share | webhook | ntfy | manual
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Erfasste Zeit an einer Aufgabe – endedAt null heißt: läuft gerade (höchstens eine je Konto).
model TimeEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  seconds      Int       @default(0)
  /// Fokus-Timer: Ziel in Minuten (z. B. 25) – null bei der Stoppuhr
  focusMinutes Int?
  createdAt    DateTime  @default(now())

  @@index([userId, endedAt])
  @@index([projectId])
  @@index([taskId])
}

/// Laufende oder einmalige Kosten eines Projekts (Hosting, Domain, KI-API …).
model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  currency    String   @default("EUR")
  /// MONTHLY | YEARLY | ONCE
  interval    String   @default("MONTHLY")
  /// Nächste Verlängerung "YYYY-MM-DD" – rückt nach dem Termin von selbst weiter
  renewsOn    String?
  note        String?
  /// Für welche Verlängerung schon gewarnt wurde
  notifiedFor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

/// Prompt-Bibliothek eines Kontos – allgemein oder an ein Projekt gebunden.
model Prompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  /// Text mit Platzhaltern wie {{projekt}}, {{repo}}, {{live}}, {{summary}}
  body      String
  tags      String[] @default([])
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Heute-Ansicht: bis zu fünf Aufgaben, die sich ein Konto für einen Tag vornimmt.
model TaskFocus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Kalendertag "YYYY-MM-DD" (Europe/Berlin)
  day       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, taskId, day])
  @@index([userId, day])
}

/// Wochen-Vorschläge: bis zu fünf Hinweise je Konto und Woche – regelbasiert, ohne KI.
model Suggestion {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Montag der Woche "YYYY-MM-DD" (Europe/Berlin)
  week      String
  /// Regel und Ziel, z. B. "vuln:<projectId>" – je Woche nur einmal
  key       String
  /// vuln | ci | git | renewal | overdue | sleeping | major | plan | describe
  kind      String
  /// Werte für die Texte (Projektname, Pakete …)
  data      Json      @default("{}")
  /// Rang in der Woche (wichtigster zuerst)
  position  Int       @default(0)
  /// OPEN | ACCEPTED | DISMISSED
  status    String    @default("OPEN")
  /// Beim Annehmen angelegte Aufgabe
  taskId    String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([userId, week, key])
  @@index([userId, week])
}

/// Einzelne Prüfung einer Live-Seite – 30 Tage aufbewahrt.
model UptimeCheck {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  ok        Boolean
  status    Int?
  ms        Int?
  error     String?

  @@index([projectId, at])
}

/// Posteingang der Benachrichtigungen – die Windows-App holt ihn ab; nach 30 Tagen gelöscht.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  title     String
  message   String
  url       String?
  /// Gelesen (Glocke in der Kopfleiste) – null heißt ungelesen
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Benachrichtigungen eines Kontos: Kanäle und Anlässe
model NotificationSettings {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vollständige ntfy-Adresse samt Thema, z. B. https://ntfy.sh/mein-thema
  ntfyUrl         String?
  /// Optionales ntfy-Zugangstoken (AES-256-GCM)
  ntfyTokenCipher String?
  /// Kritisches mit höchster ntfy-Priorität (durchbricht „Nicht stören“, wenn in der App erlaubt)
  urgentCritical  Boolean   @default(true)
  /// Webhook – Discord, Slack oder beliebiger JSON-Empfänger
  webhookUrl      String?
  /// Versand über den SMTP-Server der Instanz
  email           String?
  /// { taskDue, accessRequest, issueClosed, ciFailed, updated } – fehlt ein Schlüssel, ist der Anlass an
  events          Json      @default("{}")
  /// Kalendertag der letzten Zusammenfassung fälliger Aufgaben
  digestSentOn    String?
  /// Regeln (#109): { words, people, projects } – wichtige Wörter kommen immer durch
  rules           Json?
  /// Montag (Kalendertag) des letzten Wochenberichts (#82)
  weeklyReportOn  String?
  lastSentAt      DateTime?
  /// "kanal|meldung" des letzten Fehlschlags
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

// ── Teilen ──────────────────────────────────────────────────

enum ProjectRole {
  VIEWER
  EDITOR
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

/// Mitglied eines geteilten Projekts. Der Besitzer steht nicht hier, sondern in Project.ownerId.
model ProjectMember {
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Alte Stufe – nur noch Rückfall, wenn die Rolle gelöscht wurde (neue Vergaben: VIEWER)
  role      ProjectRole @default(VIEWER)
  roleId    String?
  roleRef   Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// Anfrage auf Zugriff über einen geteilten Link – je Konto und Projekt höchstens eine.
model AccessRequest {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole         @default(VIEWER)
  message   String?
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  decidedAt DateTime?

  @@unique([projectId, userId])
  @@index([projectId, status])
}

// ── Dateien ─────────────────────────────────────────────────

/// Hochgeladene Datei (z. B. eigenes Hintergrundbild). Die Datei selbst
/// liegt unter DATA_DIR/uploads/<id>.<ext>.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("background")
  mime      String
  ext       String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Mini-Docs ───────────────────────────────────────────────

/// Eine Seite in den Mini-Docs: Markdown-Seite, gespeicherte Webseite oder
/// eigene HTML-Seite. Seiten bilden einen Baum; privat, optional teilbar.
model Doc {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Doc?      @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Doc[]     @relation("DocTree")
  kind       DocKind   @default(PAGE)
  title      String
  /// Emoji vor dem Titel
  icon       String?
  /// Markdown (Seite, Notizen zu einer Webseite) bzw. HTML-Quelltext
  content    String    @default("")
  /// Gespeicherte Webseite: Adresse und archivierter, lesbarer Inhalt
  sourceUrl  String?
  archive    String?
  archivedAt DateTime?
  /// Rang unter den Geschwistern im Baum
  position   Int       @default(0)
  pinned     Boolean   @default(false)
  share      DocShare  @default(PRIVATE)
  shareToken String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, parentId, position])
}
